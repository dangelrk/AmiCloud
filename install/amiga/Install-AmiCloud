;
; Aufruf in einer Shell, in der Installationsschublade:
;     CD AmiCloud
;     Execute Install-AmiCloud
;
; Fragt nach jedem Teil, bevor er kopiert wird. Eine vorhandene
; Konfiguration (ENVARC:amicloud.cfg, ENV:amicloud.cfg) und ein
; vorhandener DOSDriver DEVS:DOSDrivers/CLOUD werden nie überschrieben.
; Ausführliche Anleitung: Docs/AmiCloud.guide, Kapitel Installation.

FailAt 21

If NOT EXISTS C/amicloud
  Echo "Install-AmiCloud bitte in der AmiCloud-Schublade starten:"
  Echo "  CD AmiCloud"
  Echo "  Execute Install-AmiCloud"
  Quit 10
EndIf

Set AC_FEHLER 0
Set AC_PREFS 0
Set AC_HANDLER 0

Echo ""
Echo "AmiCloud-Installation"
Echo "====================="
Echo "Benötigt: AmigaOS 3.x, TCP/IP-Stack (bsdsocket.library), AmiSSL 5,"
Echo "für den Commander zusätzlich MUI 3.8. Antworten mit y (ja) oder n (nein)."
Echo ""

; ---- Kommandozeilenprogramme ---------------------------------------------
Ask "Kommandozeilenprogramme amicloud, amicloud-shell, cloudsync nach C: kopieren? (y/n)"
If WARN
  Copy C/amicloud C/amicloud-shell C/cloudsync TO C: QUIET
  If ERROR
    Echo "FEHLER: Kopieren nach C: fehlgeschlagen."
    Set AC_FEHLER 1
  Else
    Protect C:amicloud +rwed >NIL:
    Protect C:amicloud-shell +rwed >NIL:
    Protect C:cloudsync +rwed >NIL:
    Echo "  C:amicloud, C:amicloud-shell, C:cloudsync installiert."
  EndIf
EndIf

; ---- Commander (MUI) -----------------------------------------------------
Ask "Dateimanager amicloud-commander (braucht MUI) nach SYS:Tools kopieren? (y/n)"
If WARN
  Copy C/amicloud-commander TO SYS:Tools/ QUIET
  If ERROR
    Echo "FEHLER: Kopieren nach SYS:Tools fehlgeschlagen."
    Set AC_FEHLER 1
  Else
    Protect SYS:Tools/amicloud-commander +rwed >NIL:
    Echo "  SYS:Tools/amicloud-commander installiert (ohne Icon)."
  EndIf
EndIf

; ---- AmiCloudPrefs -------------------------------------------------------
Ask "Einstellungs-Editor AmiCloudPrefs nach SYS:Prefs kopieren? (y/n)"
If WARN
  Copy C/AmiCloudPrefs TO SYS:Prefs/ QUIET
  If ERROR
    Echo "FEHLER: Kopieren nach SYS:Prefs fehlgeschlagen."
    Set AC_FEHLER 1
  Else
    Protect SYS:Prefs/AmiCloudPrefs +rwed >NIL:
    Set AC_PREFS 1
    Echo "  SYS:Prefs/AmiCloudPrefs installiert (ohne Icon)."
  EndIf
EndIf

; ---- CLOUD:-Handler ------------------------------------------------------
Ask "Laufwerk CLOUD: installieren (L:amicloud-handler, L:amicloud-worker, DOSDriver)? (y/n)"
If WARN
  Copy C/amicloud-handler C/amicloud-worker TO L: QUIET
  If ERROR
    Echo "FEHLER: Kopieren nach L: fehlgeschlagen."
    Set AC_FEHLER 1
  Else
    Protect L:amicloud-handler +rwed >NIL:
    Protect L:amicloud-worker +rwed >NIL:
    Set AC_HANDLER 1
    Echo "  L:amicloud-handler und L:amicloud-worker installiert."
    If EXISTS DEVS:DOSDrivers/CLOUD
      Echo "  DEVS:DOSDrivers/CLOUD ist schon vorhanden und bleibt unverändert."
    Else
      Copy Storage/DOSDrivers/CLOUD TO DEVS:DOSDrivers/ QUIET
      If ERROR
        Echo "FEHLER: Kopieren nach DEVS:DOSDrivers fehlgeschlagen."
        Set AC_FEHLER 1
      Else
        Echo "  DEVS:DOSDrivers/CLOUD installiert (wird ab jetzt beim Booten gemountet)."
      EndIf
    EndIf
  EndIf
EndIf

; ---- Konfiguration (nie überschreiben) -----------------------------------
Echo ""
If EXISTS ENVARC:amicloud.cfg
  Echo "ENVARC:amicloud.cfg ist schon vorhanden und bleibt unverändert."
Else
  Copy Examples/amicloud.cfg.example ENVARC:amicloud.cfg QUIET
  If ERROR
    Echo "FEHLER: ENVARC:amicloud.cfg konnte nicht angelegt werden."
    Set AC_FEHLER 1
  Else
    Echo "Beispielkonfiguration nach ENVARC:amicloud.cfg kopiert."
  EndIf
EndIf
If NOT EXISTS ENV:amicloud.cfg
  If EXISTS ENVARC:amicloud.cfg
    Copy ENVARC:amicloud.cfg ENV:amicloud.cfg QUIET
  EndIf
EndIf

If $AC_PREFS EQ 1
  Ask "AmiCloudPrefs jetzt starten, um Server, Benutzer und Passwort einzutragen? (y/n)"
  If WARN
    Echo "Im Fenster die Werte eintragen und Speichern wählen."
    SYS:Prefs/AmiCloudPrefs
  EndIf
EndIf

; ---- Mounten -------------------------------------------------------------
If $AC_HANDLER EQ 1
  Assign >NIL: EXISTS CLOUD:
  If WARN
    Ask "CLOUD: jetzt mounten? Die Konfiguration muss dafür fertig sein. (y/n)"
    If WARN
      Mount CLOUD:
      If ERROR
        Echo "FEHLER: Mount CLOUD: ist fehlgeschlagen (siehe Handbuch, Fehlersuche)."
        Set AC_FEHLER 1
      Else
        Echo "CLOUD: ist gemountet. Test: Dir CLOUD:"
      EndIf
    EndIf
  Else
    Echo "CLOUD: ist bereits gemountet. Neue Programmversionen und"
    Echo "Konfigurationsänderungen wirken dort erst nach einem Neustart."
  EndIf
EndIf

; ---- Handbuch ------------------------------------------------------------
Assign >NIL: EXISTS HELP:
If WARN
  Echo "HELP: ist nicht zugewiesen, das Handbuch bleibt in Docs/AmiCloud.guide."
Else
  Copy Docs/AmiCloud.guide TO HELP: QUIET
  If ERROR
    Echo "Hinweis: Handbuch konnte nicht nach HELP: kopiert werden."
  Else
    Echo "Handbuch nach HELP:AmiCloud.guide kopiert."
  EndIf
EndIf

; ---- Abschluss -----------------------------------------------------------
Echo ""
If $AC_FEHLER EQ 1
  Echo "Installation mit FEHLERN beendet - bitte die Meldungen oben prüfen."
Else
  Echo "Installation beendet."
EndIf
Echo ""
Echo "Nächste Schritte:"
Echo "  1. Zugangsdaten eintragen: SYS:Prefs/AmiCloudPrefs (Speichern)"
Echo "     oder ENVARC:amicloud.cfg mit einem Editor bearbeiten."
Echo "  2. Verbindung testen:      amicloud list /"
Echo "  3. Laufwerk:               Dir CLOUD:  (nach Neustart oder Mount CLOUD:)"
Echo "  4. Handbuch:               MultiView Docs/AmiCloud.guide"
Echo ""

Unset AC_FEHLER
Unset AC_PREFS
Unset AC_HANDLER
