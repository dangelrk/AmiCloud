; $VER: Install-AmiCloud @VERSION@ (@DATE@)
; Installer-Skript für AmiCloud (AmigaOS 3.x, Commodore-Installer ab 43)
; SPDX-License-Identifier: GPL-3.0-or-later
; Copyright (C) 2026 Ronny Krueger
;
; Start: Icon "Install-AmiCloud" doppelt anklicken, oder in der Shell
;     CD AmiCloud
;     Installer Install-AmiCloud
; Ohne Installer gibt es dasselbe als Shell-Skript:
;     Execute Install-AmiCloud.shell
;
; Vorhandene Konfiguration (ENV:/ENVARC:amicloud.cfg) und ein vorhandener
; DOSDriver AMICLOUD werden nie überschrieben.
; Ein erneuter Start über eine vorhandene Installation aktualisiert sie:
; Programme werden nur ersetzt, wenn die installierte Version nicht neuer
; ist (im Expertenmodus fragt der Installer), vorhandene Icons bleiben.

(set @app-name "AmiCloud")
(set @default-dest "SYS:")
(set #fehler 0)

(onerror
  (message "\nDie Installation wurde abgebrochen.\n\n"
           "Bereits kopierte Dateien bleiben erhalten;\n"
           "ein erneuter Start setzt sie wieder ein.")
)

; ---- Kopieren mit Versionsprüfung ----------------------------------------
; P_KOPIE kopiert #datei aus der Schublade #qdir nach #ziel. Liegt dort
; schon eine Datei gleichen Namens, vergleicht P_KOPIE die Versionen
; ($VER, getversion):
;   Einsteiger, Geübter Benutzer: ist die installierte Version NEUER als
;     die im Archiv, bleibt sie stehen (gemerkt in #behalten); gleiche
;     und ältere Versionen werden ersetzt.
;   Experte: zeigt beide Versionen und fragt jedes Mal.
; Mit #icon = 1 kommt das Icon mit, aber nur, wenn am Ziel noch keins
; liegt - eigene Tooltypes und Positionen bleiben so erhalten.
(set #behalten "")
(set #v 0)
(procedure P_VTEXT
  (if (= #v 0) "unbekannt" (cat (/ #v 65536) "." (BITAND #v 65535))))

(procedure P_KOPIE
  (set #quelle (tackon #qdir #datei))
  (set #zielpfad (tackon #ziel #datei))
  (set #ersetzen 1)
  (if (> (exists #zielpfad (noreq)) 0)
    (
      (set #vneu (getversion #quelle))
      (set #valt (getversion #zielpfad))
      (set #v #vneu) (set #tneu (P_VTEXT))
      (set #v #valt) (set #talt (P_VTEXT))
      (if (= @user-level 2)
        (set #ersetzen
          (askbool
            (prompt #zielpfad "\nist schon vorhanden.\n\n"
                    "Installiert: " #talt "\n"
                    "Im Archiv: " #tneu
                    (if (< #vneu #valt)
                      "\n\nDie installierte Version ist NEUER!" "")
                    "\n\nDurch die Datei aus dem Archiv ersetzen?")
            (help "Ersetzen: die Datei aus diesem Archiv wird kopiert.\n\n"
                  "Behalten: die installierte Datei bleibt unverändert.\n\n"
                  "Außerhalb des Expertenmodus ersetzt der Installer "
                  "gleiche und ältere Versionen ohne Nachfrage und "
                  "behält neuere.\n\n" @askbool-help)
            (choices "Ersetzen" "Behalten")
            (default (if (< #vneu #valt) 0 1))))
        (if (< #vneu #valt)
          (
            (set #ersetzen 0)
            (set #behalten (cat #behalten #zielpfad " " #talt "\n"))
          )))
    ))
  (if #ersetzen
    (if (AND #icon (= 0 (exists (cat #zielpfad ".info") (noreq))))
      (copyfiles
        (prompt #datei " nach " #ziel " kopieren")
        (help @copyfiles-help)
        (source #quelle)
        (dest #ziel)
        (infos) (noposition))
      (copyfiles
        (prompt #datei " nach " #ziel " kopieren")
        (help @copyfiles-help)
        (source #quelle)
        (dest #ziel))))
)

; P_KOPIE für eine Datei aus C/ (#icon 0) bzw. mit Icon (#icon 1)
(procedure P_PROG  (set #qdir "C") (set #icon 0) (P_KOPIE))
(procedure P_TOOL  (set #qdir "C") (set #icon 1) (P_KOPIE))

; Meldung über behaltene neuere Dateien (am Ende der Installation;
; (all): auch im Einsteigermodus, der sonst keine Meldungen zeigt)
(procedure P_BEHALTEN
  (if (> (strlen #behalten) 0)
    (message "\nNicht ersetzt, weil die installierte\n"
             "Version neuer ist als die im Archiv:\n\n" #behalten
             (all))))

(if (= 0 (exists "C/amicloud" (noreq)))
  (abort "Die AmiCloud-Programme wurden nicht gefunden.\n\n"
         "Bitte den Installer aus der ausgepackten AmiCloud-Schublade "
         "starten (Icon Install-AmiCloud).")
)

; ---- Prozessor ------------------------------------------------------------
; Ab Version 0.2 sind alle Programme für den 68020 übersetzt (AmiSSL 5
; braucht ihn ohnehin). Auf einem 68000/68010 würden sie abstürzen.
(if (or (= (database "cpu") "68000") (= (database "cpu") "68010"))
  (abort "AmiCloud @VERSION@ braucht mindestens einen 68020.\n\n"
         "Dieser Amiga hat einen " (database "cpu") "."))

; ---- Voraussetzungen -----------------------------------------------------
; Nur was als Datei in LIBS: liegen muss. Den TCP/IP-Stack prüft das Skript
; nicht: bsdsocket.library liegt je nach Stack woanders oder wird erst beim
; Start des Stacks erzeugt.
(set #fehlt "")
(if (= 0 (exists "LIBS:amisslmaster.library" (noreq)))
  (set #fehlt (cat #fehlt "AmiSSL 5 (LIBS:amisslmaster.library)\n")))
(if (= 0 (exists "LIBS:muimaster.library" (noreq)))
  (set #fehlt (cat #fehlt "MUI (für amicloud-commander)\n")))

(message "\nAmiCloud @VERSION@ - eigener Cloud-Speicher\n\n"
         "Kommandozeile, Shell, Dateimanager und\n"
         "Laufwerk AMICLOUD: für einen AmiCloud-Server.\n"
         "Benötigt TCP/IP-Stack und AmiSSL 5,\n"
         "der Dateimanager außerdem MUI 3.8."
         (if (> (strlen #fehlt) 0)
           (cat "\n\nNicht gefunden (Installation geht trotzdem):\n" #fehlt)
           ""))

; ---- Auswahl -------------------------------------------------------------
(set #teile
  (askoptions
    (prompt "Welche Teile von AmiCloud sollen installiert werden?")
    (help "Kommandozeilenprogramme: amicloud, amicloud-shell und "
          "amicloud-sync nach C:.\n\n"
          "Dateimanager: amicloud-commander (MUI) mit Icon nach SYS:Tools.\n\n"
          "AmiCloudPrefs: Einstellungs-Editor für Server, Benutzer und "
          "Passwort, mit Icon nach SYS:Prefs.\n\n"
          "Laufwerk AMICLOUD:: Handler und Netzwerk-Prozess nach L: und "
          "ein DOSDriver.\n\n"
          "Handbuch: AmiCloud.guide nach HELP: (falls zugewiesen).\n\n"
          @askoptions-help)
    (choices "Kommandozeilenprogramme (C:)"
             "Dateimanager amicloud-commander (SYS:Tools)"
             "Einstellungen AmiCloudPrefs (SYS:Prefs)"
             "Laufwerk AMICLOUD: (Handler)"
             "Handbuch (HELP:)")
    (default 31)))

(if (= #teile 0)
  (exit "Es wurde nichts ausgewählt - nichts installiert." (quiet)))

; ---- Kommandozeilenprogramme --------------------------------------------
(if (IN #teile 0)
  (
    (working "Kommandozeilenprogramme werden kopiert")
    (set #ziel "C:")
    (set #datei "amicloud") (P_PROG)
    (set #datei "amicloud-shell") (P_PROG)
    (set #datei "amicloud-sync") (P_PROG)
  )
)
(complete 20)

; ---- Dateimanager --------------------------------------------------------
(if (IN #teile 1)
  (
    (working "Dateimanager wird kopiert")
    (set #ziel "SYS:Tools")
    (set #datei "amicloud-commander") (P_TOOL)
  )
)
(complete 35)

; ---- AmiCloudPrefs -------------------------------------------------------
(if (IN #teile 2)
  (
    (working "AmiCloudPrefs wird kopiert")
    (set #ziel "SYS:Prefs")
    (set #datei "AmiCloudPrefs") (P_TOOL)
  )
)
(complete 50)

; ---- Laufwerk AMICLOUD: --------------------------------------------------
(set #dosdriver "")
(if (IN #teile 3)
  (
    (working "Handler wird kopiert")
    (set #ziel "L:")
    (set #datei "amicloud-handler") (P_PROG)
    (set #datei "amicloud-worker") (P_PROG)

    (set #auto
      (askchoice
        (prompt "Wann soll das Laufwerk AMICLOUD: verfügbar sein?")
        (help "Bei jedem Systemstart: der DOSDriver kommt nach "
              "DEVS:DOSDrivers und AMICLOUD: wird beim Booten gemountet "
              "(der Netzwerk-Prozess startet erst beim ersten Zugriff).\n\n"
              "Nur bei Bedarf: der DOSDriver kommt nach "
              "SYS:Storage/DOSDrivers; gemountet wird per Doppelklick auf "
              "sein Icon oder mit  Mount SYS:Storage/DOSDrivers/AMICLOUD.\n\n"
              @askchoice-help)
        (choices "Bei jedem Systemstart (DEVS:DOSDrivers)"
                 "Nur bei Bedarf (SYS:Storage/DOSDrivers)")
        (default 0)))
    (if (= #auto 0)
      (set #ddir "DEVS:DOSDrivers")
      (set #ddir "SYS:Storage/DOSDrivers"))
    (set #dosdriver (tackon #ddir "AMICLOUD"))

    (if (= 0 (exists #ddir (noreq)))
      (makedir #ddir))
    (if (> (exists #dosdriver (noreq)) 0)
      (message "\n" #dosdriver " ist schon vorhanden und bleibt unverändert.")
      (copyfiles
        (prompt "DOSDriver AMICLOUD nach " #ddir " kopieren")
        (help @copyfiles-help)
        (source "Storage/DOSDrivers/AMICLOUD")
        (dest #ddir)
        (infos) (noposition)))
  )
)
(complete 70)

; ---- Konfiguration (nie überschreiben) -----------------------------------
(if (= 0 (exists "ENVARC:amicloud.cfg" (noreq)))
  (
    (copyfiles
      (prompt "Beispielkonfiguration als ENVARC:amicloud.cfg anlegen")
      (help @copyfiles-help)
      (source "Examples/amicloud.cfg.example")
      (dest "ENVARC:")
      (newname "amicloud.cfg"))
  )
)
(if (= 0 (exists "ENV:amicloud.cfg" (noreq)))
  (copyfiles
    (prompt "Konfiguration nach ENV: kopieren")
    (help @copyfiles-help)
    (source "ENVARC:amicloud.cfg")
    (dest "ENV:")))

(if (IN #teile 2)
  (if (askbool
        (prompt "Jetzt AmiCloudPrefs starten, um Server, Benutzer und "
                "Passwort einzutragen?\n\n"
                "Im Fenster die Werte eintragen und 'Speichern' wählen; "
                "danach geht es hier weiter.")
        (help "AmiCloudPrefs schreibt ENV:amicloud.cfg und "
              "ENVARC:amicloud.cfg. Ohne diese Angaben schlägt jede "
              "Verbindung zum Server fehl.\n\n" @askbool-help)
        (choices "Starten" "Später")
        (default 1))
    (run "SYS:Prefs/AmiCloudPrefs")))
(complete 80)

; ---- Mounten -------------------------------------------------------------
(if (> (strlen #dosdriver) 0)
  (if (= 0 (run "Assign >NIL: EXISTS AMICLOUD:"))
    (message "\nAMICLOUD: ist bereits gemountet. Neue Programmversionen "
             "und geänderte Einstellungen wirken dort erst nach einem "
             "Neustart.")
    (if (askbool
          (prompt "AMICLOUD: jetzt mounten?\n\n"
                  "(Die Zugangsdaten sollten dafür eingetragen sein.)")
          (help "Mountet das Laufwerk sofort, ohne Neustart. Danach zeigt "
                "z.B.  Dir AMICLOUD:  den Inhalt der Cloud.\n\n"
                @askbool-help)
          (choices "Mounten" "Nicht jetzt")
          (default 1))
      (if (<> 0 (run (cat "Mount " #dosdriver)))
        (
          (set #fehler 1)
          (message "\nMount " #dosdriver " ist fehlgeschlagen.\n\n"
                   "Hinweise im Handbuch, Kapitel Fehlersuche.")
        )
      ))))
(complete 90)

; ---- Handbuch ------------------------------------------------------------
(if (IN #teile 4)
  (if (= 2 (exists "HELP:" (noreq)))
    (
      (set #qdir "Docs") (set #icon 1) (set #ziel "HELP:")
      (set #datei "AmiCloud.guide") (P_KOPIE)
    )
    (message "\nHELP: ist nicht zugewiesen - das Handbuch bleibt in "
             "Docs/AmiCloud.guide in der Installationsschublade.")))
(complete 100)

; ---- Abschluss -----------------------------------------------------------
(P_BEHALTEN)
(message
  (if (= #fehler 0)
    "\nAmiCloud ist installiert.\n\n"
    "\nAmiCloud ist installiert, aber nicht alles\nhat geklappt (siehe oben).\n\n")
  "Zugangsdaten: SYS:Prefs/AmiCloudPrefs\n"
  "Test in der Shell:  amicloud list /\n"
  "Laufwerk:  Dir AMICLOUD:\n"
  "Handbuch:  Docs/AmiCloud.guide\n\n"
  "Entfernen: Icon Uninstall-AmiCloud")
(exit (quiet))
