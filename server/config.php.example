/* AmiCloud server configuration — copy to config.php and fill in values */

/* Lokale Zeitzone fuer alle Zeitstempel (list/info/status/setdate).
 * Bewusst NICHT UTC: der Amiga-Client zeigt immer die lokale Systemzeit,
 * daher muss der Server dieselbe Zeitzone verwenden, damit Zeitstempel
 * direkt vergleichbar sind (kein Offset-Rechnen noetig). */
define('AMICLOUD_TIMEZONE', 'Europe/Berlin');

define('DB_HOST',       'localhost');
define('DB_NAME',       'amicloud');
define('DB_USER',       'amicloud');
define('DB_PASS',       'changeme');

/* Absolute path to storage directory — must be OUTSIDE the web root */
define('STORAGE_PATH',  '/var/amicloud-storage');

/* Maximum upload size in bytes (must match php.ini post_max_size) */
define('MAX_UPLOAD',    100 * 1024 * 1024);

/* NUR lokale Entwicklung (php -S kann kein TLS): HTTP statt HTTPS erlauben.
 * In Produktion diese Zeile weglassen oder auf false setzen! */
/* define('AMICLOUD_ALLOW_HTTP', true); */
