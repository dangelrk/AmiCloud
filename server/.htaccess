<Files "config.php">
    Require all denied
</Files>
<FilesMatch "^(config\.php\.example)$">
    Require all denied
</FilesMatch>
# includes/ itself is blocked by includes/.htaccess -- <DirectoryMatch> is
# NOT allowed inside a .htaccess file (only in the main server/vhost
# config); having it here makes Apache reject this whole file as invalid
# and 500 every request under this directory (same bug found and fixed
# for server/ in production, 2026-07-12).
