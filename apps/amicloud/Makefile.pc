# amicloud — one-shot CLI, linked against libcloudhttp + libcloudcore.
# Copy of the old client/main.c (docs/design/05_Refactoring_Client_Handler.md, M5).
#
# Build:   make -f Makefile.pc            (builds the libs it depends on first)
# Install: sudo make -f Makefile.pc install

CC       = gcc

LIBS_DIR   = ../../core
CORE_DIR   = $(LIBS_DIR)/libcloudcore
HTTP_DIR   = $(LIBS_DIR)/libcloudhttp

CORE_INC = $(CORE_DIR)/include/cloudcore
HTTP_INC = $(HTTP_DIR)/include/cloudhttp

PKG_CF  := $(shell pkg-config --cflags libcurl 2>/dev/null)
PKG_LF  := $(shell pkg-config --libs   libcurl 2>/dev/null)
ifeq ($(PKG_CF),)
  PKG_CF := -I/opt/homebrew/include -I/usr/local/include
  PKG_LF := -L/opt/homebrew/lib -L/usr/local/lib -lcurl
endif

CFLAGS  = -O2 -Wall -Wextra -std=c99 -I$(CORE_INC) -I$(HTTP_INC) $(PKG_CF)

OBJDIR = obj/pc
BINDIR = ../../bin/pc
LIBDIR = ../../lib/pc
LDFLAGS = -L$(LIBDIR) $(PKG_LF)

TARGET = $(BINDIR)/amicloud
OBJS   = $(OBJDIR)/main.o

all: libs $(TARGET)

libs:
	$(MAKE) -C $(CORE_DIR) -f Makefile.pc
	$(MAKE) -C $(HTTP_DIR) -f Makefile.pc

$(TARGET): $(OBJS) | $(BINDIR)
	$(CC) $(CFLAGS) -o $@ $(OBJS) -lcloudhttp -lcloudcore $(LDFLAGS)

$(OBJDIR)/%.o: src/%.c | $(OBJDIR)
	$(CC) $(CFLAGS) -c -o $@ $<

$(OBJDIR) $(BINDIR):
	mkdir -p $@

install: $(TARGET)
	install -m 755 $(TARGET) /usr/local/bin/

clean:
	rm -rf $(OBJDIR)
	rm -f $(TARGET)

.PHONY: all libs install clean
